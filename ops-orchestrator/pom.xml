<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ticket.ops</groupId>
        <artifactId>ops-agent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ops-orchestrator</artifactId>
    <name>ops-orchestrator</name>
    <description>Runnable Spring Boot entry: rule engine, incident API and workflow</description>

    <dependencies>
        <dependency>
            <groupId>com.ticket.ops</groupId>
            <artifactId>ops-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ticket.ops</groupId>
            <artifactId>ops-mcp-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ticket.ops</groupId>
            <artifactId>ops-mcp-plugins</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ticket.ops</groupId>
            <artifactId>ops-analyzer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ticket.ops</groupId>
            <artifactId>ops-knowledge</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ticket.ops</groupId>
            <artifactId>ops-gate</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- 文档指定的 Graph 编排运行时，P0 先完成依赖与扩展点预留 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
